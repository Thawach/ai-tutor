# AI Tutor 16.22 deployment configuration
#
# Copy this file to .env and adjust values for the target environment.
# Never commit the real .env file.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=AI Tutor

# Available courses:
# - electronics
# - mathematics
ACTIVE_COURSE=electronics

# ------------------------------------------------------------
# Chat provider
# ------------------------------------------------------------

# Supported values:
# - ollama
# - groq
AI_PROVIDER=ollama

# ------------------------------------------------------------
# Groq chat configuration
# ------------------------------------------------------------

# Required only when AI_PROVIDER=groq.
# Keep this blank in .env.example.
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------
# Ollama configuration
# ------------------------------------------------------------

# Ollama is also used for embeddings even when AI_PROVIDER=groq.
OLLAMA_HOST=http://localhost:11434

# Used for chat when AI_PROVIDER=ollama.
OLLAMA_MODEL=qwen3:8b

# Used for RAG embeddings for all chat providers.
EMBEDDING_MODEL=nomic-embed-text
